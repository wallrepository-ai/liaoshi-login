{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "Agent",
      "Skill",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskStop",
      "Monitor",
      "SendMessage",
      "ListAgents",
      "ReadNotifications",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "Workflow",
      "SendUserFile",
      "PushNotification",
      "ListConnectors",
      "ListSkills",
      "ListPlugins",
      "mcp__Supabase",
      "mcp__github",
      "mcp__Gmail",
      "mcp__Google_Drive",
      "mcp__AI-DB",
      "mcp__Claude_Docs",
      "mcp__Consensus",
      "mcp__Claude_Code_Remote",
      "mcp__claude-code-remote",
      "mcp__464477e7-31b6-4b4d-9d9d-f1cbbb56e384"
    ],
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/home/user"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/allow_all.sh\" pre",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/allow_all.sh\" permission",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
